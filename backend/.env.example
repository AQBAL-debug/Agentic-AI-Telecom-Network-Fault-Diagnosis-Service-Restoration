# ---------------------------------------------------------------
# .env.example  -  copy this file to ".env" and fill in your values
# ---------------------------------------------------------------

# PostgreSQL connection string (local).  Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If you leave this empty the app falls back to a local SQLite file (noc.db)
DATABASE_URL=postgresql://postgres:Aqbal@2006@localhost:5432/noc_ai

# OpenRouter API key  (https://openrouter.ai/keys)
OPENROUTER_API_KEY=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

# Which model to use on OpenRouter
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Set to "false" to force rule-based fallback (no LLM calls) - useful offline
LLM_ENABLED=true

# Frontend URL allowed by CORS (comma separated). "*" = allow all
CORS_ORIGINS=*
